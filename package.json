{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "upload-to-copyparty",
  "title": "Upload to Copyparty",
  "description": "Upload clipboard files or text to Copyparty",
  "icon": "icon.png",
  "author": "local",
  "platforms": ["macOS"],
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "upload-clipboard",
      "title": "Upload Clipboard to Copyparty",
      "description": "Inspect the clipboard and upload a copied file",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "uploadUrl",
      "title": "Upload URL",
      "description": "HTTPS URL of the Copyparty destination folder",
      "type": "textfield",
      "required": true,
      "default": "https://f.chuu.moe/files/"
    },
    {
      "name": "username",
      "title": "Username",
      "description": "Copyparty username",
      "type": "textfield",
      "required": true,
      "default": "adm"
    },
    {
      "name": "password",
      "title": "Password",
      "description": "Copyparty password",
      "type": "password",
      "required": true
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^2.7.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.5",
    "typescript": "^5.9.3"
  }
}
